# Variáveis do backend (Spring Boot). Cadastre os valores reais SOMENTE na Vercel
# (Settings → Environment Variables) ou no ambiente local. Nunca versione valores.

# Mesma conexão Postgres do Supabase usada pelo sistema atual (formato postgres://).
# Prefira o pooler em modo transação (porta 6543).
DATABASE_URL=postgresql://USUARIO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Segredo exclusivo do novo sistema para assinar a sessão (>= 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Opcionais
# DB_POOL_SIZE=3
# SESSION_COOKIE_SECURE=true   # use false apenas em http://localhost
